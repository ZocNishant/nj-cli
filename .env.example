# LinkedIn cookie for scraping (optional)
LINKEDIN_LI_AT=your_li_at_cookie_here

# Adzuna API credentials (free tier: 1000 calls/day)
# Sign up: https://developer.adzuna.com
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# JSearch API (RapidAPI) — aggregates 30+ job boards (LinkedIn, Indeed, Glassdoor, etc.)
# Free tier: 10 searches/day. Sign up: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=your_rapidapi_key_here

# USAJobs.gov (optional — government ML/AI roles)
# Free registration: https://www.usajobs.gov/Help/authentication/
USAJOBS_API_KEY=your_usajobs_key_here
USAJOBS_USER_AGENT=your@email.com

# Gmail OAuth2 credentials file path (for nj watch)
GMAIL_CREDENTIALS_JSON=gmail_credentials.json
