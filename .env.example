# Secrets only. Preferences belong in config.yaml, which is also gitignored.
# Set the key for whichever provider config.yaml names; the others can stay blank.

# OpenAI — required when llm.provider is "openai".
# Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Anthropic — required when llm.provider is "claude".
# Create one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Groq or any other OpenAI-shaped endpoint — required when provider is
# "freellmapi". Pair with freellmapi_base_url in config.yaml.
# Create one at https://console.groq.com/keys
GROQ_API_KEY=gsk-your-key-here


# --- Job sources -----------------------------------------------------------
#
# Without at least one of Adzuna or JSearch, a run is served by the free
# no-auth boards, which skew remote/EU. Those two are what supply US roles,
# so for a US sponsorship search they are effectively required.

# Adzuna — aggregates 15+ US sources. Free tier: 1000 calls/day.
# 1. Register at https://developer.adzuna.com/signup
# 2. Confirm the email, then open https://developer.adzuna.com/admin/access_details
# 3. Copy Application ID and Application Key below.
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# JSearch via RapidAPI — 30+ boards (LinkedIn, Indeed, Glassdoor, ZipRecruiter).
# Free tier: ~200 requests/month, enough to evaluate it.
# 1. Sign in at https://rapidapi.com
# 2. Subscribe to https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch (Basic = free)
# 3. Copy the X-RapidAPI-Key shown on the endpoint page.
JSEARCH_API_KEY=your_rapidapi_key_here

# USAJobs.gov (optional) — government and national-lab ML/AI roles.
# Free registration: https://developer.usajobs.gov/APIRequest
USAJOBS_API_KEY=your_usajobs_key_here
USAJOBS_USER_AGENT=your@email.com

# LinkedIn: intentionally absent. `nj/scrapers/linkedin.py` is an inert stub and
# no code path reads a session cookie any more. Cookie-driven scraping risks a
# checkpoint or permanent ban on the account you job-hunt from, so nj does not
# ask you for one. Use Adzuna and JSearch instead.


# --- Notifications ---------------------------------------------------------

# Gmail OAuth2 credentials file path (for nj watch)
GMAIL_CREDENTIALS_JSON=gmail_credentials.json

# SendGrid, for emailing yourself the generated bundle (optional)
SENDGRID_API_KEY=your_sendgrid_key_here
